# ============================================================
# 客服工作台（web-cs）本地开发环境变量
# 与管理端物理隔离：端口 5175、独立 storage 前缀 cs-token（D1）
# ============================================================

# ---------- 端口与部署路径 ----------
# base 默认 '/'，本地直接开 http://localhost:5175/ 即可；
# 生产若与管理端同域不同子路径，把它改成 /cs/ 再构建。
VITE_PORT = 5175
VITE_PUBLIC_PATH = /
VITE_ROUTER_HISTORY = "h5"

# ---------- 后端网关 ----------
# 开发态走 Vite 代理，浏览器与后端同源，WebSocket 握手才能带上 Cookie/自定义头。
# 下面 4 个变量由 vite.config.ts 的 loadEnv(mode, cwd) 读取并生效。
VITE_API_BASE = /api
VITE_PROXY_API_TARGET = http://127.0.0.1:8088
VITE_PROXY_WS_TARGET = ws://127.0.0.1:8088

# ---------- 令牌隔离（核心） ----------
# 必须与管理端 sent_admin、商城端 sent_user 不同：
# 同域下三个前端共用一份 localStorage，前缀撞了会互相顶掉登录态。
# 客服端仍用 aud=admin（客服属于员工侧账号），但令牌物理隔离在 cs-token_* 键下。
VITE_TOKEN_STORAGE_PREFIX = cs-token
VITE_AUD = admin
