{
  "name": "@sent/e2e",
  "version": "1.0.0",
  "private": true,
  "description": "森特体育用品管理系统 · 全流程 Playwright E2E 验收",
  "scripts": {
    "test": "node ./node_modules/@playwright/test/cli.js test",
    "test:full": "node ./node_modules/@playwright/test/cli.js test --workers=1",
    "test:fast": "node ./node_modules/@playwright/test/cli.js test --project=parallel",
    "test:session": "node ./node_modules/@playwright/test/cli.js test --project=shared-session --workers=1",
    "test:cart": "node ./node_modules/@playwright/test/cli.js test --project=shared-cart --workers=1",
    "test:buckets": "node ./run-e2e.mjs",
    "test:core": "node ./node_modules/@playwright/test/cli.js test e2e-core-flow.spec.ts",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
