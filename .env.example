# ==========================================================================
# sent-sports-b2b · 环境变量模板
#
# 本文件只包含占位符与演示值，不含任何真实凭证，可安全提交。
# 用法：复制为 .env（已被 .gitignore 忽略）后按本机情况填写；切勿把填好的 .env 提交。
#   cp .env.example .env
#
# 生产 profile 下 DB_USERNAME / DB_PASSWORD / JWT_SECRET / PAY_MOCK_SECRET
# 四项无默认值，缺失时应用拒绝启动。
# ==========================================================================

# ---------- 运行环境 ----------
APP_PROFILE=dev
APP_ENV=dev
SERVER_PORT=8088

# ---------- 数据库（仅本机演示值，换成你自己的本地库） ----------
DB_HOST=127.0.0.1
DB_USERNAME=root
DB_PASSWORD=change-me-local-only

# ---------- Redis（可选，本地默认无口令） ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- 密钥：请自行生成，绝不要提交真实值 ----------
# 生成示例：openssl rand -hex 32
JWT_SECRET=replace-with-a-random-32-byte-hex-string
PAY_MOCK_SECRET=replace-with-another-random-string

# ---------- 跨域白名单（部署时改成真实前端域名，逗号分隔） ----------
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- 上传目录 ----------
UPLOAD_BASE_DIR=/data/upload

# ---------- 发票 PDF（全部为虚构演示值，禁止用于真实开票） ----------
INVOICE_FONT_FILE=
INVOICE_SELLER_NAME=示例体育用品（演示）有限公司
INVOICE_SELLER_TAX_NO=DEMO-TAX-NO-0000000000000
INVOICE_SELLER_ADDRESS=示例市示例区演示路1号 000-00000000
INVOICE_SELLER_BANK=演示银行示例支行 0000 0000 0000 0000
INVOICE_CODE_PREFIX=0000000

# ---------- 前端 dev 代理（也可直接改两端 .env.development） ----------
VITE_PROXY_API_TARGET=http://127.0.0.1:8088
VITE_PROXY_WS_TARGET=ws://127.0.0.1:8088
