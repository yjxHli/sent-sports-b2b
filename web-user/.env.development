# ============================================================
# 商城端（web-user）本地开发环境变量
# 与 web-admin 的物理隔离：端口 5173、base /、独立 storage 前缀与 aud（D1）
# ============================================================

VITE_PORT = 5173
VITE_PUBLIC_PATH = /
VITE_ROUTER_HISTORY = "h5"

# 由 web-user/vite.config.ts 的 loadEnv 读取
VITE_API_BASE = /api
VITE_PROXY_API_TARGET = http://127.0.0.1:8088
VITE_PROXY_WS_TARGET = ws://127.0.0.1:8088

# 双端令牌隔离：禁止与管理端共用前缀 / aud
VITE_TOKEN_STORAGE_PREFIX = sent_user
VITE_AUD = user
