# ============================================================
# 管理端本地开发环境变量（vite --mode development 自动加载）
# 参考 plan §9.4.4 ④ / P6-05：端口 5174、base /admin/、h5 路由、/api 与 /ws 代理
# ============================================================

# ---------- 端口与部署路径 ----------
VITE_PORT = 5174
VITE_PUBLIC_PATH = /admin/
VITE_ROUTER_HISTORY = "h5"

# ---------- 后端网关 ----------
# 开发环境走 Vite 代理，浏览器与后端同源，避免 CORS / 自定义响应头被浏览器吞掉。
# 下面 4 个变量由 vite.config.ts 的 loadEnv(mode, cwd) 读取并生效：
#   VITE_PORT / VITE_PUBLIC_PATH / VITE_PROXY_API_TARGET / VITE_PROXY_WS_TARGET
# 后端默认 8088（8080 会被 Steam 的 steamwebhelper 抢占）；
# 如再改端口只需改下面两行，不必动 vite.config.ts。
VITE_API_BASE = /api
VITE_PROXY_API_TARGET = http://127.0.0.1:8088
VITE_PROXY_WS_TARGET = ws://127.0.0.1:8088

# ---------- 双端令牌隔离（D1） ----------
# web-user 必须使用不同的前缀（如 sent_user），禁止共用一份 token / 同一个 aud。
VITE_TOKEN_STORAGE_PREFIX = sent_admin
VITE_AUD = admin

# 备注：生产环境由 Nginx 转发 /api、/ws，且后端 WebMvcConfig 已
# Access-Control-Expose-Headers: X-New-Token,X-Token-Expire-In,X-Idempotent-Replay，
# 否则跨域下浏览器读不到 X-New-Token。
